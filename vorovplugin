# One file, nothing else needed: drop it into SBPE's plugins folder. Steam
# client only (it checks the client build and does nothing on any other).
#
# What you need in the inventory: the offense armor (Berserker) and one other
# body armor, one worn and one carried. For the mobility swap, Stompers and
# Boosters the same way.
#
# Every option in onInit can be set in config.ini under [plugin_armor_swap];
# without that section the defaults here are used. The ones you may have to
# change are the keys, they have to match your game keys:
#   key_main, key_sec        main and secondary attack (D, S)
#   key_warp                 the dash key (Shift), with
#   key_warp_dirs            left/down/right for a duskwing warp (J K L)
#   key_blast_dirs           up/left/down/right for a wildfire blast (I J K L)
# To switch it on and off with a key, add to [plugin_keybinds]:
#   armor_swap active toggle yes no = Keypad 7
#   armor_swap mobility_active toggle yes no = Keypad 8
#
# Automatic body armor swap: wear the body armor with the most armor all the
# time, and put the offense armor (Berserker) on only while attacking with no
# hit about to land. A duskwing gets it for the instant a spin or warp starts:
# the damage of an attack is fixed right then, see attackStart.
#
# The same plugin also swaps the mobility item: one on the ground (Stompers),
# another in the air (Boosters). The air item goes on the moment the character
# leaves the ground, jumping or falling, the ground item a moment after it
# lands.
#
# A "hit" is predicted from what the client can see: enemy objects that deal
# contact damage (bullets, the enemies themselves) are assumed to keep moving
# the way they did over the last few frames, and active damage hitboxes count
# where they are. Things that appear on top of the character, change direction
# or home in are seen late or not at all.


class modinv:
    '''
    Sends the game's own "move item" command, the one the inventory screen
    sends when you equip something, without opening the inventory. It goes
    through the game's own function, so it is paid for from the input
    buffer like any other input.
    '''
    # WorldClient::handleModifyInv(const ModifyInv&) and
    # ModifyInv::ModifyInv() in the steam client. the bytes at these
    # addresses are checked before use, on any other build move() does
    # nothing
    HANDLE_MODIFY_INV = 0x4db870
    HANDLE_MODIFY_INV_SIG = bytes.fromhex('5589e5565389ce83ec108b5d088b4948')
    MODIFY_INV_CTOR = 0x53f670
    MODIFY_INV_CTOR_SIG = bytes.fromhex('55c701')  # then the vtable address
    MODINV_MOVE = 2
    # what one command takes out of the input buffer
    COST = 75
    # cdecl -> thiscall with one argument: int thunk(this, function, arg)
    THISCALL_THUNK = bytes.fromhex(
        '5589e5'    # push ebp; mov ebp, esp
        '83e4f0'    # and esp, -16
        '83ec0c'    # sub esp, 12
        '8b4d08'    # mov ecx, [ebp+8]
        '8b450c'    # mov eax, [ebp+12]
        'ff7510'    # push [ebp+16]
        'ffd0'      # call eax
        '89ec5dc3'  # mov esp, ebp; pop ebp; ret
    )

    wffi = cffi.FFI()
    wffi.cdef('''
void *__stdcall VirtualAlloc(void *addr, size_t size, uint32_t type, uint32_t protect);
void *__stdcall GetCurrentProcess(void);
int __stdcall ReadProcessMemory(void *proc, const void *addr, void *buf, size_t size, size_t *read);
typedef int (*thiscall1)(void *self, void *fn, void *arg);
''')

    _state = None  # (thunk, vtable) once set up, False if unusable

    @staticmethod
    def _read(k32, addr, size):
        w = modinv.wffi
        buf = w.new('uint8_t[]', size)
        ok = k32.ReadProcessMemory(
            k32.GetCurrentProcess(), w.cast('void *', addr),
            buf, size, w.NULL)
        return bytes(w.buffer(buf)) if ok else None

    @staticmethod
    def ready():
        if modinv._state is not None:
            return bool(modinv._state)
        modinv._state = False
        w = modinv.wffi
        k32 = w.dlopen('kernel32.dll')
        if modinv._read(k32, modinv.HANDLE_MODIFY_INV, 16) != \
                modinv.HANDLE_MODIFY_INV_SIG:
            logging.error('armor_swap: unknown client build, not swapping')
            return False
        ctor = modinv._read(k32, modinv.MODIFY_INV_CTOR, 7)
        if ctor is None or ctor[:3] != modinv.MODIFY_INV_CTOR_SIG:
            logging.error('armor_swap: unknown client build, not swapping')
            return False
        # MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE
        mem = k32.VirtualAlloc(w.NULL, 4096, 0x3000, 0x40)
        if mem == w.NULL:
            logging.error('armor_swap: VirtualAlloc failed, not swapping')
            return False
        w.memmove(mem, modinv.THISCALL_THUNK, len(modinv.THISCALL_THUNK))
        modinv._state = (w.cast('thiscall1', mem),
                         int.from_bytes(ctor[3:], 'little'))
        return True

    @staticmethod
    def move(refs, slotpos, target):
        '''move the item at slotpos to target, swapping with what is there'''
        wc = refs.WorldClient
        if not modinv.ready() or wc == ffi.NULL:
            return False
        w = modinv.wffi
        thunk, vtable = modinv._state
        # ModifyInv: classptr, command, slotpos, targetslotpos,
        # _cached_size, _has_bits
        msg = w.new('uint32_t[6]',
                    [vtable, modinv.MODINV_MOVE, slotpos, target, 0, 7])
        thunk(w.cast('void *', int(ffi.cast('uintptr_t', wc))),
              w.cast('void *', modinv.HANDLE_MODIFY_INV), msg)
        return True


