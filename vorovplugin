def overlap(a, b):
    '''do the boxes (x, y, w, h) overlap?'''
    return a[0] < b[0] + b[2] and b[0] < a[0] + a[2] and \
        a[1] < b[1] + b[3] and b[1] < a[1] + a[3]


def hitTime(a, b, vx, vy, horizon):
    '''
    when does box b, moving at (vx, vy) relative to box a, first overlap it?
    boxes are (x, y, w, h). returns seconds from now, or None if not within
    the horizon.
    '''
    enter, leave = 0.0, horizon
    for amin, asize, bmin, bsize, v in ((a[0], a[2], b[0], b[2], vx),
                                        (a[1], a[3], b[1], b[3], vy)):
        amax, bmax = amin + asize, bmin + bsize
        if v == 0:
            if bmax <= amin or bmin >= amax:
                return None
            continue
        t1 = (amin - bmax) / v
        t2 = (amax - bmin) / v
        if t1 > t2:
            t1, t2 = t2, t1
        enter = max(enter, t1)
        leave = min(leave, t2)
        if enter > leave:
            return None
    return enter


